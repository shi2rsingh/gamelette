---
import Layout from '../layouts/Layout.astro';
import { getBreadcrumbSchema } from '../util/seo';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://gamelette.com';
const breadcrumbSchema = getBreadcrumbSchema(
  [
    { name: 'Home', url: '/' },
    { name: 'Contact', url: '/contact' },
  ],
  siteUrl
);

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${siteUrl}/contact/#webpage`,
  url: `${siteUrl}/contact/`,
  name: 'Contact (Placeholder) — Gamelette',
  description: 'Contact information and feedback channel for Gamelette.',
  isPartOf: {
    '@id': `${siteUrl}/#website`,
  },
};

const jsonLd = [breadcrumbSchema, contactPageSchema];
---

<Layout
  title="Contact (Placeholder) — Gamelette"
  description="Contact information and feedback channel for Gamelette."
  jsonLd={jsonLd}
>
  <div class="py-16 md:py-24 bg-base-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li>
            <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
          </li>
          <li>/</li>
          <li class="font-semibold text-slate-900">Contact</li>
        </ol>
      </nav>

      <!-- Badge -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-900 mb-4">
        <span>📬 Support Channel</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mb-4">
        Get in Touch
      </h1>
      <p class="text-base text-slate-600 mb-8">
        Have feedback on Moody Man or Mancala? Have an idea for a new game to whip up? We’d love to hear from you.
      </p>

      <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-sm mb-8">
        <strong>Notice:</strong> This is currently a contact placeholder. Update the email address below to your preferred support inbox before production launch.
      </div>

      <!-- Contact Options Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12">
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
          <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center text-xl font-bold mb-4">
            ✉️
          </div>
          <h2 class="text-lg font-bold text-slate-900 mb-1">Direct Email</h2>
          <p class="text-xs text-slate-500 mb-3">General inquiries & feedback</p>
          <a
            href="mailto:contact@gamelette.com"
            class="text-sm font-semibold text-amber-600 hover:text-amber-700 underline"
          >
            contact@gamelette.com
          </a>
          <span class="block text-[11px] text-slate-400 mt-1">(Placeholder email)</span>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-xl font-bold mb-4">
            🐛
          </div>
          <h2 class="text-lg font-bold text-slate-900 mb-1">Bug Reports</h2>
          <p class="text-xs text-slate-500 mb-3">Game-specific glitches or feedback</p>
          <p class="text-sm text-slate-700">
            Please include the game title (Moody Man or Mancala) and your browser/device details.
          </p>
        </div>
      </div>

      <!-- Contact Form Placeholder -->
      <div class="p-8 rounded-3xl bg-slate-50 border border-slate-200">
        <h2 class="text-xl font-bold text-slate-900 mb-2">Send a Message</h2>
        <p class="text-xs text-slate-500 mb-6">Template form — connect to Netlify Forms or your email API of choice.</p>

        <form id="contact-form" class="space-y-4">
          <div>
            <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Your Name</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="e.g. Alex"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 text-sm"
              required
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Your Email</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="alex@example.com"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 text-sm"
              required
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Message / Game Suggestion</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder="Tell us what you think or suggest a game idea..."
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 text-sm"
              required
            ></textarea>
          </div>

          <button
            type="submit"
            class="px-6 py-3 rounded-xl font-bold text-sm bg-amber-500 hover:bg-amber-600 text-slate-950 transition-colors cursor-pointer"
          >
            Submit Message
          </button>
        </form>
      </div>

      <div class="mt-12 pt-8 border-t border-slate-200">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm bg-slate-900 text-white hover:bg-slate-800 transition-colors"
        >
          ← Return to Gamelette Home
        </a>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        alert('This is a template contact form. Please email us directly at contact@gamelette.com in the meantime!');
      });
    }
  </script>
</Layout>
