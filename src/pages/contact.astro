---
import Layout from '../layouts/Layout.astro';
import { getBreadcrumbSchema } from '../util/seo';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://gamelette.com';
const breadcrumbSchema = getBreadcrumbSchema(
  [
    { name: 'Home', url: '/' },
    { name: 'Contact', url: '/contact' },
  ],
  siteUrl
);

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${siteUrl}/contact/#webpage`,
  url: `${siteUrl}/contact`,
  name: 'Contact — Gamelette',
  description: 'Contact information and feedback channel for Gamelette.',
  isPartOf: {
    '@id': `${siteUrl}/#website`,
  },
};

const jsonLd = [breadcrumbSchema, contactPageSchema];
---

<Layout
  title="Contact — Gamelette"
  description="Contact information and feedback channel for Gamelette."
  jsonLd={jsonLd}
>
  <div class="py-16 md:py-24 bg-base-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li>
            <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
          </li>
          <li>/</li>
          <li class="font-semibold text-slate-900">Contact</li>
        </ol>
      </nav>

      <!-- Badge -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-900 mb-4">
        <span>📬 Support Channel</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mb-4">
        Get in Touch
      </h1>
      <p class="text-base text-slate-600 mb-8">
        Have feedback on Moody Man or Mancala? Have an idea for a new game to whip up? We’d love to hear from you.
      </p>

      <!-- Contact Options Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12">
        {/* TODO: Re-enable once contact@gamelette.com is configured */}
        {/* <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
          <div class="w-10 h-10 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center text-xl font-bold mb-4">
            ✉️
          </div>
          <h2 class="text-lg font-bold text-slate-900 mb-1">Direct Email</h2>
          <p class="text-xs text-slate-500 mb-3">General inquiries & feedback</p>
          <a
            href="mailto:contact@gamelette.com"
            class="text-sm font-semibold text-amber-600 hover:text-amber-700 underline"
          >
            contact@gamelette.com
          </a>
        </div> */}

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-xl font-bold mb-4">
            🐛
          </div>
          <h2 class="text-lg font-bold text-slate-900 mb-1">Bug Reports</h2>
          <p class="text-xs text-slate-500 mb-3">Game-specific glitches or feedback</p>
          <p class="text-sm text-slate-700">
            Please include the game title (Moody Man or Mancala) and your browser/device details.
          </p>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="p-8 rounded-3xl bg-slate-50 border border-slate-200">
        <h2 class="text-xl font-bold text-slate-900 mb-2">Send a Message</h2>
        <p class="text-xs text-slate-500 mb-6">We read every message and aim to reply within a few days.</p>

        <!-- Success message (shown via JS after submit) -->
        <div id="form-success" class="hidden p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-sm mb-6" role="alert">
          <strong>Message sent!</strong> Thanks for reaching out — we'll get back to you soon.
        </div>

        <form
          id="contact-form"
          name="contact"
          method="POST"
          action="/contact"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          class="space-y-4"
        >
          <!-- Honeypot field: hidden from real users, catches bots that fill every field -->
          <p class="hidden" aria-hidden="true">
            <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <!-- Netlify requires a hidden form-name field when submitting via fetch -->
          <input type="hidden" name="form-name" value="contact" />

          <div>
            <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Your Name</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="e.g. Alex"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 text-sm"
              required
            />
          </div>

          <div>
            <label for="topic" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Topic / Game</label>
            <select
              id="topic"
              name="topic"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 text-sm"
            >
              <option value="Gamelette" selected>Gamelette (General)</option>
              <option value="Moody Man">Moody Man</option>
              <option value="Mancala">Mancala</option>
            </select>
          </div>

          <div>
            <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Your Email</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="alex@example.com"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 text-sm"
              required
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Message / Game Suggestion</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder="Tell us what you think or suggest a game idea..."
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 text-sm"
              required
            ></textarea>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="px-6 py-3 rounded-xl font-bold text-sm bg-amber-500 hover:bg-amber-600 text-slate-950 transition-colors cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
          >
            Submit Message
          </button>
        </form>
      </div>

      <div class="mt-12 pt-8 border-t border-slate-200">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm bg-slate-900 text-white hover:bg-slate-800 transition-colors"
        >
          ← Return to Gamelette Home
        </a>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const successMsg = document.getElementById('form-success');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!submitBtn) return;

        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';

        try {
          const data = new FormData(form);
          const response = await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
          });

          if (response.ok) {
            form.reset();
            form.classList.add('hidden');
            successMsg?.classList.remove('hidden');
          } else {
            throw new Error('Network response was not ok');
          }
        } catch {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Submit Message';
          alert('Something went wrong sending your message. Please try again later.');
        }
      });
    }
  </script>
</Layout>
