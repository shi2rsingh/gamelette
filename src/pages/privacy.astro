---
import Layout from '../layouts/Layout.astro';
import { getBreadcrumbSchema } from '../util/seo';

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://gamelette.com';
const breadcrumbSchema = getBreadcrumbSchema(
  [
    { name: 'Home', url: '/' },
    { name: 'Privacy Policy', url: '/privacy' },
  ],
  siteUrl
);

const privacyPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${siteUrl}/privacy/#webpage`,
  url: `${siteUrl}/privacy`,
  name: 'Privacy Policy — Gamelette',
  description: 'Privacy policy information for Gamelette and its browser games collection.',
  isPartOf: {
    '@id': `${siteUrl}/#website`,
  },
};

const jsonLd = [breadcrumbSchema, privacyPageSchema];
---

<Layout
  title="Privacy Policy — Gamelette"
  description="Privacy policy information for Gamelette and its browser games collection."
  jsonLd={jsonLd}
>
  <div class="py-16 md:py-24 bg-base-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li>
            <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
          </li>
          <li>/</li>
          <li class="font-semibold text-slate-900">Privacy Policy</li>
        </ol>
      </nav>

      <!-- Badge -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-900 mb-4">
        <span>📋 Data &amp; Privacy</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mb-4">
        Privacy Policy
      </h1>
      <p class="text-sm text-slate-500 mb-8">
        Last updated: October 2026
      </p>

      <div class="prose prose-slate max-w-none space-y-6 text-slate-700 leading-relaxed">

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-slate-900">1. Overview</h2>
          <p>
            Gamelette (<a href="https://gamelette.com" class="text-amber-600 underline">gamelette.com</a>) is an open web portal providing links to lightweight browser games. We believe in privacy-conscious web design: you can browse the catalog and jump directly into games without registering an account.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-slate-900">2. Personal Information</h2>
          <p>
            Gamelette does not require you to provide your name, email address, physical location, or payment information to view this landing page or play the linked games.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-slate-900">3. Independent Game Subdomains</h2>
          <p>
            Games linked from Gamelette (including <code>moodyman.gamelette.com</code> and <code>mancala.gamelette.com</code>) are hosted on independent subdomains. Game progress (such as score or local settings) may be saved locally in your browser’s LocalStorage on your own device and is not transmitted to central tracking servers.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-slate-900">4. Hosting & CDN Logs</h2>
          <p>
            Like virtually all websites deployed on platforms like Netlify, standard technical request logs (IP address, user-agent, requested URL) may be processed transiently by hosting infrastructure for DDoS mitigation, performance caching, and security auditing.
          </p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-slate-900">5. Contact Information</h2>
          <p>
            If you have questions about this privacy statement, you can reach out via our <a href="/contact" class="text-amber-600 underline">Contact page</a>.
          </p>
        </section>
      </div>

      <div class="mt-12 pt-8 border-t border-slate-200">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm bg-slate-900 text-white hover:bg-slate-800 transition-colors"
        >
          ← Return to Gamelette Home
        </a>
      </div>
    </div>
  </div>
</Layout>
