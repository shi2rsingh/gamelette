---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Locale, DEFAULT_LOCALE, LOCALES_INFO, SUPPORTED_LOCALES } from '../i18n/locales';
import { getTranslations, getLocaleFromPath, getAlternateLinks, getLocalizedPath } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  keywords?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  locale?: Locale;
}

const currentPath = Astro.url.pathname;
const detectedLocale = (Astro.currentLocale as Locale) || getLocaleFromPath(currentPath) || DEFAULT_LOCALE;
const {
  locale = detectedLocale,
  ogImage = '/og-image.png',
  jsonLd,
} = Astro.props;

const t = getTranslations(locale);
const localeInfo = LOCALES_INFO[locale] || LOCALES_INFO[DEFAULT_LOCALE];

const title = Astro.props.title || t.meta.homeTitle;
const description = Astro.props.description || t.meta.homeDescription;
const keywords = Astro.props.keywords || t.meta.keywords;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://gamelette.com';

// Ensure canonical URL has trailing slash matching directory output
const normalizedPath = currentPath.endsWith('/') ? currentPath : `${currentPath}/`;
const canonicalUrl = new URL(normalizedPath, siteUrl).toString();
const absoluteOgImage = new URL(ogImage, siteUrl).toString();

const alternateLinks = getAlternateLinks(currentPath, siteUrl);
const xDefaultUrl = `${siteUrl}${getLocalizedPath(currentPath, DEFAULT_LOCALE)}`;

// Alternate locales for Open Graph
const otherOgLocales = SUPPORTED_LOCALES
  .filter((loc) => loc !== locale)
  .map((loc) => LOCALES_INFO[loc].ogLocale);
const isProd = import.meta.env.PROD;
---

<!doctype html>
<html lang={locale} dir={localeInfo.dir} data-theme="cupcake" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO Meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Gamelette" />
    <meta name="publisher" content="Gamelette" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Alternates for i18n SEO -->
    {alternateLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.locale} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />

    <!-- Favicons & Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FAF7F2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0F172A" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gamelette" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={absoluteOgImage.endsWith('.png') ? 'image/png' : absoluteOgImage.endsWith('.jpg') ? 'image/jpeg' : 'image/svg+xml'} />
    <meta property="og:locale" content={localeInfo.ogLocale} />
    {otherOgLocales.map((other) => (
      <meta property="og:locale:alternate" content={other} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- JSON-LD Structured Data -->
    {jsonLd && (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(jsonLd)}
      />
    )}

    <!-- Umami Analytics (Production only) -->
    {isProd && (
      <script
        is:inline
        defer
        src="https://khoji.shishirsingh.com/script.js"
        data-website-id="db7ed3e2-a809-4014-92ae-50b474fa385f"
      />
    )}
  </head>
  <body class="bg-base-100 text-slate-800 antialiased selection:bg-amber-200 selection:text-amber-900">
    <!-- Accessible Skip Link -->
    <a href="#main-content" class="skip-link">
      {t.common.skipToContent}
    </a>

    <!-- Header -->
    <Header currentPath={currentPath} locale={locale} />

    <!-- Main Content Landmark -->
    <main id="main-content" class="flex-1 focus:outline-none">
      <slot />
    </main>

    <!-- Footer -->
    <Footer currentPath={currentPath} locale={locale} />
  </body>
</html>
