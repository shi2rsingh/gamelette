---
import type { Game } from '../data/games';

interface Props {
  game: Game;
  index: number;
}

const { game, index } = Astro.props;
---

<article
  class="group relative flex flex-col rounded-3xl bg-base-100 border-2 border-slate-200/90 hover:border-amber-400/80 shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden"
  aria-labelledby={`game-title-${game.id}`}
>
  <!-- Top Visual Banner / Artwork -->
  <div class="relative w-full h-52 sm:h-60 bg-slate-900 overflow-hidden flex items-center justify-center">
    <!-- Background Preview Image -->
    <img
      src={game.previewImage}
      alt={game.previewAlt}
      class="absolute inset-0 w-full h-full object-cover opacity-85 group-hover:scale-103 group-hover:opacity-95 transition-all duration-500"
      loading={index === 0 ? 'eager' : 'lazy'}
    />

    <!-- Gradient overlay for text legibility & warm aesthetic -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-transparent"></div>

    <!-- Category Badge Floating Top Left -->
    <div class="absolute top-4 left-4 z-10 flex items-center gap-2">
      <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-900/80 backdrop-blur-md text-amber-300 border border-amber-400/30">
        {game.category}
      </span>
    </div>

    <!-- Subdomain pill Floating Top Right -->
    <div class="absolute top-4 right-4 z-10">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-mono font-medium bg-black/60 backdrop-blur-md text-slate-300 border border-white/10">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        {game.subdomain}
      </span>
    </div>

    <!-- Game Icon & Title Bar on Banner bottom -->
    <div class="absolute bottom-4 left-4 right-4 z-10 flex items-center gap-3.5">
      <img
        src={game.icon}
        alt=""
        aria-hidden="true"
        class="w-14 h-14 rounded-2xl bg-slate-800 border-2 border-white/20 shadow-lg object-contain p-1 shrink-0"
      />
      <div>
        <h3 id={`game-title-${game.id}`} class="text-2xl sm:text-3xl font-black text-white tracking-tight leading-none drop-shadow-sm">
          {game.title}
        </h3>
        <p class="text-xs sm:text-sm font-medium text-amber-200/90 mt-1 line-clamp-1">
          {game.tagline}
        </p>
      </div>
    </div>
  </div>

  <!-- Content Body -->
  <div class="p-6 sm:p-7 flex flex-col flex-1">
    <!-- Tags -->
    <div class="flex flex-wrap gap-1.5 sm:gap-2 mb-4" aria-label="Game tags">
      {game.tags.map((tag) => (
        <span class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200">
          {tag}
        </span>
      ))}
    </div>

    <!-- Description -->
    <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal mb-5">
      {game.description}
    </p>

    <!-- Key Authentic Features -->
    <div class="mb-6 pt-4 border-t border-slate-100">
      <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2.5">
        What to expect:
      </h4>
      <ul class="space-y-2 text-xs sm:text-sm text-slate-700">
        {game.features.map((feature) => (
          <li class="flex items-start gap-2">
            <svg class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            <span>{feature}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Prominent Play Action Link -->
    <div class="mt-auto pt-4">
      <a
        href={game.url}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl font-bold text-sm sm:text-base bg-amber-500 hover:bg-amber-600 text-slate-950 shadow-md hover:shadow-lg transition-all active:scale-98"
        aria-label={`Play ${game.title} now on ${game.subdomain} (opens in new tab)`}
      >
        <svg class="w-5 h-5 text-slate-950" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
        <span>Play {game.title}</span>
        <svg class="w-4 h-4 ml-0.5 opacity-70" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
          <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
        </svg>
      </a>
    </div>
  </div>
</article>
