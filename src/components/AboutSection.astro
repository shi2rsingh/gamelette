---
import { type Locale, DEFAULT_LOCALE } from '../i18n/locales';
import { getTranslations } from '../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(locale);
---

<section id="about" class="py-16 md:py-24 bg-base-100 border-t border-base-200 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-bold uppercase tracking-wider mb-3">
          <span>{t.aboutSection.badge}</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
          {t.aboutSection.title}
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600">
          {t.aboutSection.subtitle}
        </p>
      </div>

      <!-- Story Narrative Cards -->
      <div class="space-y-6">
        <div class="p-6 sm:p-8 rounded-3xl bg-slate-50 border border-slate-200">
          <div class="flex items-start gap-4">
            <span class="text-3xl shrink-0">🍳</span>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">{t.aboutSection.card1Title}</h3>
              <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
                {t.aboutSection.card1Desc}
              </p>
            </div>
          </div>
        </div>

        <div class="p-6 sm:p-8 rounded-3xl bg-slate-50 border border-slate-200">
          <div class="flex items-start gap-4">
            <span class="text-3xl shrink-0">🌐</span>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">{t.aboutSection.card2Title}</h3>
              <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
                {t.aboutSection.card2Desc}
              </p>
            </div>
          </div>
        </div>

        <div class="p-6 sm:p-8 rounded-3xl bg-slate-50 border border-slate-200">
          <div class="flex items-start gap-4">
            <span class="text-3xl shrink-0">✨</span>
            <div>
              <h3 class="text-xl font-bold text-slate-900 mb-2">{t.aboutSection.card3Title}</h3>
              <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
                {t.aboutSection.card3Desc}
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
