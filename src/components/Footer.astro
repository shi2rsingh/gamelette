---
import { type Locale, DEFAULT_LOCALE } from '../i18n/locales';
import { getTranslations, getLocalizedPath, stripLocaleFromPath } from '../i18n/utils';

interface Props {
  currentPath?: string;
  locale?: Locale;
}

const { currentPath = '/', locale = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(locale);
const isHome = stripLocaleFromPath(currentPath) === '/';
const homeUrl = getLocalizedPath('/', locale);
const privacyUrl = getLocalizedPath('/privacy', locale);
const contactUrl = getLocalizedPath('/contact', locale);

const gamesLink = isHome ? '#games' : `${homeUrl}#games`;
const aboutLink = isHome ? '#about' : `${homeUrl}#about`;
---

<footer class="mt-auto bg-slate-900 text-slate-300 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12">
      <!-- Col 1: Brand Info -->
      <div class="md:col-span-2 space-y-4">
        <a
          href={homeUrl}
          class="inline-flex items-center gap-3 rounded-lg focus-visible:ring-4 focus-visible:ring-amber-400"
          aria-label={t.common.brandHomeAria}
        >
          <div class="w-9 h-9 flex items-center justify-center rounded-xl bg-slate-800 border border-slate-700">
            <svg class="w-6 h-6" viewBox="0 0 64 64" fill="none" aria-hidden="true">
              <path d="M46 18 L58 6 C59.5 4.5 62 4.5 63.5 6 C65 7.5 65 10 63.5 11.5 L51.5 23.5 Z" fill="#64748B" />
              <circle cx="28" cy="36" r="23" fill="#1E293B" stroke="#475569" stroke-width="1.5" />
              <circle cx="28" cy="36" r="20" fill="#0F172A" />
              <path d="M 23 21 C 30 20, 37 24, 39 29 C 41 34, 43 41, 37 46 C 31 50, 23 50, 18 46 C 13 42, 13 36, 16 28 C 18 22, 19 21, 23 21 Z" fill="#FFFDF9" />
              <circle cx="27" cy="35" r="9.5" fill="#F59E0B" />
            </svg>
          </div>
          <span class="text-2xl font-black text-white tracking-tight">
            Game<span class="text-amber-400">lette</span>
          </span>
        </a>

        <p class="text-sm text-slate-400 max-w-sm leading-relaxed">
          {t.footer.aboutText}
        </p>

        <p class="text-xs text-slate-500">
          {t.common.independentDeploymentNote}
        </p>
      </div>

      <!-- Col 2: Games Navigation -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-4">
          {t.footer.gamesHeading}
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a
              href="https://moodyman.gamelette.com"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-amber-400 transition-colors inline-flex items-center gap-1.5"
            >
              <span>{t.games.moodyman.title}</span>
              <span class="text-xs text-slate-500">↗</span>
            </a>
          </li>
          <li>
            <a
              href="https://mancala.gamelette.com"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-amber-400 transition-colors inline-flex items-center gap-1.5"
            >
              <span>{t.games.mancala.title}</span>
              <span class="text-xs text-slate-500">↗</span>
            </a>
          </li>
          <li>
            <a
              href={gamesLink}
              class="hover:text-amber-400 transition-colors text-slate-400"
            >
              {t.footer.allGames}
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Legal & Contact -->
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-4">
          {t.footer.siteHeading}
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a
              href={aboutLink}
              class="hover:text-amber-400 transition-colors"
            >
              {t.footer.aboutLink}
            </a>
          </li>
          <li>
            <a
              href={privacyUrl}
              class="hover:text-amber-400 transition-colors"
            >
              {t.footer.privacyLink}
            </a>
          </li>
          <li>
            <a
              href={contactUrl}
              class="hover:text-amber-400 transition-colors inline-flex items-center gap-1.5"
            >
              <span>{t.footer.contactLink}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="mt-12 pt-8 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {new Date().getFullYear()} {t.common.allRightsReserved}</p>
      <p class="flex items-center gap-1">
        <span>{t.common.cookedWithLove}</span>
        <span class="text-amber-400" aria-label="love">🍳</span>
        <span>{t.common.forWebGamers}</span>
      </p>
    </div>
  </div>
</footer>
