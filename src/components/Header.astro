---
import { type Locale, DEFAULT_LOCALE } from '../i18n/locales';
import { getTranslations, getLocalizedPath, stripLocaleFromPath } from '../i18n/utils';
import LanguageSelector from './LanguageSelector.astro';

interface Props {
  currentPath?: string;
  locale?: Locale;
}

const { currentPath = '/', locale = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(locale);
const isHome = stripLocaleFromPath(currentPath) === '/';
const homeUrl = getLocalizedPath('/', locale);

const gamesLink = isHome ? '#games' : `${homeUrl}#games`;
const whyLink = isHome ? '#why' : `${homeUrl}#why`;
const aboutLink = isHome ? '#about' : `${homeUrl}#about`;
---

<header class="sticky top-0 z-40 bg-base-100/90 backdrop-blur-md border-b border-base-200/80 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18 gap-2">
      <!-- Brand Logo -->
      <a
        href={homeUrl}
        class="group flex items-center gap-3 rounded-xl p-1.5 -ml-1.5 focus-visible:ring-4 focus-visible:ring-amber-400 focus-visible:outline-none transition-transform hover:scale-105 shrink-0"
        aria-label={t.common.brandAria}
      >
        <div class="relative w-10 h-10 flex items-center justify-center rounded-xl bg-slate-900 shadow-md group-hover:shadow-amber-500/20 transition-all">
          <!-- Skillet + Yolk Icon -->
          <svg class="w-7 h-7" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <path d="M46 18 L58 6 C59.5 4.5 62 4.5 63.5 6 C65 7.5 65 10 63.5 11.5 L51.5 23.5 Z" fill="#475569" stroke="#1E293B" stroke-width="1.5" />
            <circle cx="28" cy="36" r="23" fill="#1E293B" stroke="#475569" stroke-width="1.5" />
            <circle cx="28" cy="36" r="20" fill="#0F172A" />
            <path d="M 23 21 C 30 20, 37 24, 39 29 C 41 34, 43 41, 37 46 C 31 50, 23 50, 18 46 C 13 42, 13 36, 16 28 C 18 22, 19 21, 23 21 Z" fill="#FFFDF9" />
            <circle cx="27" cy="35" r="9.5" fill="#F59E0B" />
            <ellipse cx="24.8" cy="32" rx="3" ry="1.6" transform="rotate(-30 24.8 32)" fill="#FFFFFF" opacity="0.7" />
            <circle cx="27" cy="33" r="1.1" fill="#92400E" />
            <circle cx="27" cy="37" r="1.1" fill="#92400E" />
            <circle cx="25" cy="35" r="1.1" fill="#92400E" />
            <circle cx="29" cy="35" r="1.1" fill="#92400E" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-xl sm:text-2xl font-black tracking-tight text-slate-900 leading-none">
            Game<span class="text-amber-500">lette</span>
          </span>
          <span class="text-[10px] uppercase font-bold tracking-wider text-slate-500 mt-0.5">
            {t.common.brandTagline}
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 sm:gap-2" aria-label="Main Navigation">
        <a
          href={gamesLink}
          class="px-3 py-2 rounded-lg text-sm font-semibold text-slate-700 hover:text-slate-900 hover:bg-base-200 transition-colors"
        >
          {t.nav.games}
        </a>
        <a
          href={whyLink}
          class="px-3 py-2 rounded-lg text-sm font-semibold text-slate-700 hover:text-slate-900 hover:bg-base-200 transition-colors"
        >
          {t.nav.why}
        </a>
        <a
          href={aboutLink}
          class="px-3 py-2 rounded-lg text-sm font-semibold text-slate-700 hover:text-slate-900 hover:bg-base-200 transition-colors"
        >
          {t.nav.about}
        </a>
      </nav>

      <!-- Actions: Language Selector + Play CTA -->
      <div class="flex items-center gap-2 sm:gap-3">
        <LanguageSelector locale={locale} currentPath={currentPath} />

        <a
          href={gamesLink}
          class="inline-flex items-center gap-1.5 sm:gap-2 px-3.5 py-2 sm:px-5 sm:py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-amber-500 hover:bg-amber-600 text-slate-950 shadow-sm hover:shadow transition-all active:scale-98 shrink-0"
        >
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z" />
          </svg>
          <span>{t.nav.playNow}</span>
        </a>
      </div>
    </div>
  </div>
</header>
