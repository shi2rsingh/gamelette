---
import Layout from '../../layouts/Layout.astro';
import { getBreadcrumbSchema } from '../../util/seo';
import { type Locale, DEFAULT_LOCALE } from '../../i18n/locales';
import { getTranslations, getLocalizedPath } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(locale);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://gamelette.com';
const homeUrl = getLocalizedPath('/', locale);
const privacyUrl = getLocalizedPath('/privacy', locale);
const contactUrl = getLocalizedPath('/contact', locale);

const breadcrumbSchema = getBreadcrumbSchema(
  [
    { name: t.common.breadcrumbHome, url: homeUrl },
    { name: t.privacyPage.breadcrumb, url: privacyUrl },
  ],
  siteUrl
);

const privacyPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${siteUrl}${privacyUrl}#webpage`,
  url: `${siteUrl}${privacyUrl}`,
  name: t.meta.privacyTitle,
  description: t.meta.privacyDescription,
  inLanguage: locale,
  isPartOf: {
    '@id': `${siteUrl}/#website`,
  },
};

const jsonLd = [breadcrumbSchema, privacyPageSchema];
---

<Layout
  title={t.meta.privacyTitle}
  description={t.meta.privacyDescription}
  keywords={t.meta.keywords}
  jsonLd={jsonLd}
  locale={locale}
>
  <div class="py-16 md:py-24 bg-base-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li>
            <a href={homeUrl} class="hover:text-slate-900 transition-colors">{t.common.breadcrumbHome}</a>
          </li>
          <li>/</li>
          <li class="font-semibold text-slate-900">{t.privacyPage.breadcrumb}</li>
        </ol>
      </nav>

      <!-- Badge -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-900 mb-4">
        <span>{t.privacyPage.badge}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mb-4">
        {t.privacyPage.title}
      </h1>
      <p class="text-sm text-slate-500 mb-8">
        {t.privacyPage.lastUpdated}
      </p>

      <div class="prose prose-slate max-w-none space-y-6 text-slate-700 leading-relaxed">
        <section class="space-y-3">
          <h2 class="text-xl font-bold text-slate-900">{t.privacyPage.section1Title}</h2>
          <p>{t.privacyPage.section1Text}</p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-slate-900">{t.privacyPage.section2Title}</h2>
          <p>{t.privacyPage.section2Text}</p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-slate-900">{t.privacyPage.section3Title}</h2>
          <p>{t.privacyPage.section3Text}</p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-slate-900">{t.privacyPage.section4Title}</h2>
          <p>{t.privacyPage.section4Text}</p>
        </section>

        <section class="space-y-3">
          <h2 class="text-xl font-bold text-slate-900">{t.privacyPage.section5Title}</h2>
          <p>
            {t.privacyPage.section5Text}{' '}
            <a href={contactUrl} class="text-amber-600 underline font-semibold">
              {t.footer.contactLink}
            </a>.
          </p>
        </section>
      </div>

      <div class="mt-12 pt-8 border-t border-slate-200">
        <a
          href={homeUrl}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm bg-slate-900 text-white hover:bg-slate-800 transition-colors"
        >
          {t.common.returnHome}
        </a>
      </div>
    </div>
  </div>
</Layout>

