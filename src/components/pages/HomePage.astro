---
import Layout from '../../layouts/Layout.astro';
import Hero from '../Hero.astro';
import GamesGrid from '../GamesGrid.astro';
import WhySection from '../WhySection.astro';
import AboutSection from '../AboutSection.astro';
import { getHomePageSchema } from '../../util/seo';
import { type Locale, DEFAULT_LOCALE } from '../../i18n/locales';
import { getTranslations } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(locale);
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://gamelette.com';
const homeSchema = getHomePageSchema(siteUrl, locale);
---

<Layout
  title={t.meta.homeTitle}
  description={t.meta.homeDescription}
  keywords={t.meta.keywords}
  jsonLd={homeSchema}
  locale={locale}
>
  <!-- Hero Section with Brand Introduction -->
  <Hero locale={locale} />

  <!-- Featured Games Grid: Moody Man & Mancala -->
  <GamesGrid locale={locale} />

  <!-- Why Section: The Value Proposition & Web Purity -->
  <WhySection locale={locale} />

  <!-- About Section: The Name (Game + Omelette) & Subdomain Architecture -->
  <AboutSection locale={locale} />
</Layout>

