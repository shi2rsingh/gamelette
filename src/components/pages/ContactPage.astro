---
import Layout from '../../layouts/Layout.astro';
import { getBreadcrumbSchema } from '../../util/seo';
import { type Locale, DEFAULT_LOCALE } from '../../i18n/locales';
import { getTranslations, getLocalizedPath } from '../../i18n/utils';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getTranslations(locale);

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://gamelette.com';
const homeUrl = getLocalizedPath('/', locale);
const contactUrl = getLocalizedPath('/contact', locale);

const breadcrumbSchema = getBreadcrumbSchema(
  [
    { name: t.common.breadcrumbHome, url: homeUrl },
    { name: t.contactPage.breadcrumb, url: contactUrl },
  ],
  siteUrl
);

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${siteUrl}${contactUrl}#webpage`,
  url: `${siteUrl}${contactUrl}`,
  name: t.meta.contactTitle,
  description: t.meta.contactDescription,
  inLanguage: locale,
  isPartOf: {
    '@id': `${siteUrl}/#website`,
  },
};

const jsonLd = [breadcrumbSchema, contactPageSchema];
---

<Layout
  title={t.meta.contactTitle}
  description={t.meta.contactDescription}
  keywords={t.meta.keywords}
  jsonLd={jsonLd}
  locale={locale}
>
  <div class="py-16 md:py-24 bg-base-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-8" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li>
            <a href={homeUrl} class="hover:text-slate-900 transition-colors">{t.common.breadcrumbHome}</a>
          </li>
          <li>/</li>
          <li class="font-semibold text-slate-900">{t.contactPage.breadcrumb}</li>
        </ol>
      </nav>

      <!-- Badge -->
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-900 mb-4">
        <span>{t.contactPage.badge}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight mb-4">
        {t.contactPage.title}
      </h1>
      <p class="text-base text-slate-600 mb-8">
        {t.contactPage.subtitle}
      </p>

      <!-- Contact Options Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12">
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
          <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-xl font-bold mb-4">
            🐛
          </div>
          <h2 class="text-lg font-bold text-slate-900 mb-1">{t.contactPage.bugTitle}</h2>
          <p class="text-xs text-slate-500 mb-3">{t.contactPage.bugSubtitle}</p>
          <p class="text-sm text-slate-700">
            {t.contactPage.bugDesc}
          </p>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="p-8 rounded-3xl bg-slate-50 border border-slate-200">
        <h2 class="text-xl font-bold text-slate-900 mb-2">{t.contactPage.formTitle}</h2>
        <p class="text-xs text-slate-500 mb-6">{t.contactPage.formSubtitle}</p>

        <!-- Success message (shown via JS after submit) -->
        <div id="form-success" class="hidden p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-sm mb-6" role="alert">
          {t.contactPage.formSuccess}
        </div>

        <form
          id="contact-form"
          name="contact"
          method="POST"
          action={contactUrl}
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          class="space-y-4"
          data-sending-text={t.contactPage.btnSending}
          data-submit-text={t.contactPage.btnSubmit}
          data-error-text={t.contactPage.errorAlert}
        >
          <!-- Honeypot field -->
          <p class="hidden" aria-hidden="true">
            <label>Don't fill this out if you're human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
          </p>

          <!-- Netlify requires hidden form-name field -->
          <input type="hidden" name="form-name" value="contact" />
          <input type="hidden" name="locale" value={locale} />

          <div>
            <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
              {t.contactPage.labelName}
            </label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder={t.contactPage.placeholderName}
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 text-sm"
              required
            />
          </div>

          <div>
            <label for="topic" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
              {t.contactPage.labelTopic}
            </label>
            <select
              id="topic"
              name="topic"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 text-sm"
            >
              <option value="Gamelette" selected>{t.contactPage.topicGeneral}</option>
              <option value="Moody Man">{t.contactPage.topicMoodyMan}</option>
              <option value="Mancala">{t.contactPage.topicMancala}</option>
            </select>
          </div>

          <div>
            <label for="email" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
              {t.contactPage.labelEmail}
            </label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder={t.contactPage.placeholderEmail}
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 text-sm"
              required
            />
          </div>

          <div>
            <label for="message" class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
              {t.contactPage.labelMessage}
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              placeholder={t.contactPage.placeholderMessage}
              class="w-full px-4 py-2.5 rounded-xl border border-slate-300 bg-white focus:outline-none focus:ring-2 focus:ring-amber-400 text-sm"
              required
            ></textarea>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="px-6 py-3 rounded-xl font-bold text-sm bg-amber-500 hover:bg-amber-600 text-slate-950 transition-colors cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
          >
            {t.contactPage.btnSubmit}
          </button>
        </form>
      </div>

      <div class="mt-12 pt-8 border-t border-slate-200">
        <a
          href={homeUrl}
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm bg-slate-900 text-white hover:bg-slate-800 transition-colors"
        >
          {t.common.returnHome}
        </a>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const successMsg = document.getElementById('form-success');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

    if (form) {
      const sendingText = form.getAttribute('data-sending-text') || 'Sending…';
      const submitText = form.getAttribute('data-submit-text') || 'Submit Message';
      const errorText = form.getAttribute('data-error-text') || 'Something went wrong sending your message. Please try again later.';

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!submitBtn) return;

        submitBtn.disabled = true;
        submitBtn.textContent = sendingText;

        try {
          const data = new FormData(form);
          const response = await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
          });

          if (response.ok) {
            form.reset();
            form.classList.add('hidden');
            successMsg?.classList.remove('hidden');
          } else {
            throw new Error('Network response was not ok');
          }
        } catch {
          submitBtn.disabled = false;
          submitBtn.textContent = submitText;
          alert(errorText);
        }
      });
    }
  </script>
</Layout>

