---
import { games } from '../data/games';
import GameCard from './GameCard.astro';
---

<section id="games" class="py-16 md:py-24 bg-base-200/50 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-bold uppercase tracking-wider mb-3">
        <span>🎮 Available Now</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        Fresh From the Skillet
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Choose a game below to jump straight in. Each runs on its dedicated subdomain with quick load times and zero barriers.
      </p>
    </div>

    <!-- Games Grid (2 Cards) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">
      {games.map((game, index) => (
        <GameCard game={game} index={index} />
      ))}
    </div>

    <!-- Coming Soon Banner / Teaser -->
    <div class="mt-12 sm:mt-16 rounded-3xl bg-gradient-to-br from-amber-500/10 via-base-100 to-orange-500/10 border-2 border-dashed border-amber-300/80 p-8 sm:p-10 text-center relative overflow-hidden">
      <div class="max-w-2xl mx-auto">
        <div class="w-14 h-14 mx-auto rounded-2xl bg-amber-100 border border-amber-300 text-amber-800 flex items-center justify-center text-2xl shadow-sm mb-4">
          🍳
        </div>
        <h3 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          More Games Simmering on the Stove
        </h3>
        <p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed">
          We’re busy crafting new browser-native games to add to the menu. Expect lightweight word puzzles, spatial brain-teasers, and turn-based retro favorites cooked up with the same instant-play philosophy.
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white border border-slate-200 text-slate-600">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> In prototyping
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white border border-slate-200 text-slate-600">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> Always web-first
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white border border-slate-200 text-slate-600">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> Zero download bloat
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
