<section id="why" class="py-16 md:py-24 bg-base-100 border-t border-base-200/60 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-bold uppercase tracking-wider mb-3">
        <span>⚡ Built For Quick Fun</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
        Why Play on Gamelette?
      </h2>
      <p class="mt-4 text-base sm:text-lg text-slate-600">
        Web games shouldn’t require gigabytes of storage or tedious registrations. Here is how we keep things fast and enjoyable.
      </p>
    </div>

    <!-- Feature Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      <!-- Card 1 -->
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-50 border border-slate-200/90 hover:border-amber-300 transition-colors">
        <div class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-800 flex items-center justify-center text-2xl font-bold mb-5 shadow-xs">
          🚀
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">
          Instant Browser Play
        </h3>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Open a link and the game starts immediately. No installations, no updates to wait through, and no device storage taken up.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-50 border border-slate-200/90 hover:border-amber-300 transition-colors">
        <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-2xl font-bold mb-5 shadow-xs">
          📱
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">
          Responsive & Accessible
        </h3>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Whether you play with mouse and keyboard on desktop or tap on a smartphone screen, interfaces are designed to adapt seamlessly.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="p-6 sm:p-8 rounded-3xl bg-slate-50 border border-slate-200/90 hover:border-amber-300 transition-colors">
        <div class="w-12 h-12 rounded-2xl bg-blue-100 text-blue-800 flex items-center justify-center text-2xl font-bold mb-5 shadow-xs">
          🎯
        </div>
        <h3 class="text-xl font-bold text-slate-900 mb-2">
          Dedicated Subdomains
        </h3>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Each game is decoupled on its own subdomain for maximum performance and independent deployment from the central landing page.
        </p>
      </div>
    </div>
  </div>
</section>
