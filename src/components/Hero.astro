---
---

<section class="relative overflow-hidden pt-12 pb-16 md:pt-20 md:pb-24 border-b border-base-200/60 bg-gradient-to-b from-amber-500/5 via-base-100 to-base-100">
  <!-- Subtle decorative background warmth -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-amber-400/15 rounded-full blur-3xl"></div>
    <div class="absolute top-20 right-[-10%] w-[400px] h-[300px] bg-orange-400/10 rounded-full blur-3xl"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <!-- Playful Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-100 border border-amber-300/80 text-amber-900 text-xs sm:text-sm font-bold shadow-xs mb-6">
      <span class="inline-block animate-pulse">🍳</span>
      <span>A fresh spin on web games</span>
      <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
      <span class="text-amber-800 font-medium">Free & Instant</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black text-slate-900 tracking-tight max-w-4xl mx-auto leading-[1.08]">
      Bite-Sized Browser Games.
      <span class="block bg-gradient-to-r from-amber-600 via-amber-500 to-orange-500 bg-clip-text text-transparent">
        Whipped Up for Quick Fun.
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="mt-6 text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto font-normal leading-relaxed">
      Welcome to <strong class="text-slate-900 font-semibold">Gamelette</strong> — a curated home for lightweight, hassle-free web games. No heavy launchers, no paywalls, and no setup. Just click and play right in your browser.
    </p>

    <!-- CTAs -->
    <div class="mt-8 sm:mt-10 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
      <a
        href="#games"
        class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-bold text-base bg-amber-500 hover:bg-amber-600 text-slate-950 shadow-md hover:shadow-lg transition-all active:scale-98"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
        <span>Explore the Games</span>
      </a>

      <a
        href="#about"
        class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl font-semibold text-base text-slate-700 hover:text-slate-950 bg-slate-100 hover:bg-slate-200 border border-slate-200/80 transition-colors"
      >
        Why "Gamelette"?
      </a>
    </div>

    <!-- Honest Value Props (No fake testimonials or metrics) -->
    <div class="mt-14 pt-10 border-t border-slate-200/80 max-w-4xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 text-left">
      <div class="flex items-start gap-3 p-3 rounded-xl bg-base-100 border border-slate-200/70 shadow-xs">
        <div class="w-9 h-9 shrink-0 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-lg">
          🆓
        </div>
        <div>
          <h2 class="text-xs sm:text-sm font-bold text-slate-900">100% Free</h2>
          <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5">No hidden paywalls</p>
        </div>
      </div>

      <div class="flex items-start gap-3 p-3 rounded-xl bg-base-100 border border-slate-200/70 shadow-xs">
        <div class="w-9 h-9 shrink-0 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-lg">
          ⚡
        </div>
        <div>
          <h2 class="text-xs sm:text-sm font-bold text-slate-900">Zero Installs</h2>
          <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5">Launches in tabs</p>
        </div>
      </div>

      <div class="flex items-start gap-3 p-3 rounded-xl bg-base-100 border border-slate-200/70 shadow-xs">
        <div class="w-9 h-9 shrink-0 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-lg">
          📱
        </div>
        <div>
          <h2 class="text-xs sm:text-sm font-bold text-slate-900">Cross-Device</h2>
          <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5">Mobile, tablet & PC</p>
        </div>
      </div>

      <div class="flex items-start gap-3 p-3 rounded-xl bg-base-100 border border-slate-200/70 shadow-xs">
        <div class="w-9 h-9 shrink-0 rounded-lg bg-purple-100 text-purple-700 flex items-center justify-center font-bold text-lg">
          ☕
        </div>
        <div>
          <h2 class="text-xs sm:text-sm font-bold text-slate-900">Quick Breaks</h2>
          <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5">Pick up & play</p>
        </div>
      </div>
    </div>
  </div>
</section>
